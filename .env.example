# ---------------------------------------------------------------------------
# DrawdownCal — Environment Variables
# Copy this file to .env and fill in the values. Never commit .env.
# ---------------------------------------------------------------------------

# Public URL of the deployed site (used for canonical URLs, OG tags, sitemap)
# Example: https://ddcal.example.com
VITE_SITE_URL=http://localhost:3000

# Google Analytics 4 Measurement ID (optional — leave blank to disable)
# Example: G-XXXXXXXXXX
VITE_GA_ID=
